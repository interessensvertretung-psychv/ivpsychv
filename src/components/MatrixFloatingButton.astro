---
import Icon from './Icon.astro';
import { url } from '../lib/utils';
---

<aside class="floating-matrix" aria-label="Schnellzugang Matrix Community">
  <a href={url('/mitmachen/#matrix')} class="floating-matrix__btn box-dunkel" title="Zum Matrix/Element Space unserer Initiative">
    <span class="floating-matrix__icon-wrap">
      <Icon name="message" size={20} />
    </span>
    <span class="floating-matrix__text">
      <span class="floating-matrix__tag">Community</span>
      <span class="floating-matrix__title">Matrix Space</span>
    </span>
    <Icon name="arrow-right" size={16} class="floating-matrix__arrow" />
  </a>
</aside>

<style>
  .floating-matrix {
    position: fixed;
    right: max(1.25rem, env(safe-area-inset-right));
    bottom: max(1.25rem, calc(env(safe-area-inset-bottom) + 1.25rem));
    z-index: 35;
    pointer-events: auto;
  }

  .floating-matrix__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 1.1rem 0.55rem 0.65rem;
    background: var(--flaeche);
    border: 1.5px solid var(--akzent);
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
    box-shadow: var(--schatten);
    transition: transform 250ms var(--ease), background-color 250ms var(--ease);
  }

  .floating-matrix__btn:hover {
    background: var(--flaeche-erhoeht);
    transform: translateY(-2px);
    color: var(--text);
  }

  .floating-matrix__icon-wrap {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--akzent);
    color: var(--auf-akzent);
    flex-shrink: 0;
  }

  .floating-matrix__text {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.15;
  }

  .floating-matrix__tag {
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--akzent);
    font-weight: 600;
  }

  .floating-matrix__title {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .floating-matrix__arrow {
    color: var(--akzent);
  }

  @media (max-width: 640px) {
    /* Auf Mobilgeräten sitzt der Button sauber in der rechten unteren Ecke */
    .floating-matrix {
      right: 0.75rem;
      bottom: max(0.6rem, env(safe-area-inset-bottom));
    }
    
    .floating-matrix__btn {
      padding: 0.4rem 0.75rem 0.4rem 0.5rem;
      gap: 0.45rem;
      background: var(--flaeche);
      border: 1.5px solid var(--akzent);
      box-shadow: var(--schatten);
    }

    .floating-matrix__icon-wrap {
      width: 28px;
      height: 28px;
    }

    .floating-matrix__tag {
      font-size: 0.6rem;
    }

    .floating-matrix__title {
      font-size: 0.8rem;
    }

    .floating-matrix__arrow {
      display: none;
    }
  }
</style>
