---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { menu, organisation } from '../config/organisation';
import { url, kontaktMailto } from '../lib/utils';

const orgSeiten = (await getCollection('organisation'))
  .filter((s) => s.data.sichtbar && s.id !== 'uebersicht')
  .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);

const aktuell = Astro.url.pathname.replace(/\/$/, '') || '/';
const istAktiv = (pfad: string) => {
  const p = url(pfad).replace(/\/$/, '') || '/';
  return p === aktuell;
};
const eintraege = menu.filter((m) => m.sichtbar);
---

<dialog id="hauptmenue" class="drawer box-dunkel" aria-label="Hauptmenü">
  <div class="drawer__head">
    <span class="drawer__title">Menü</span>
    <button class="drawer__close" type="button" data-menu-close aria-label="Menü schließen">
      <Icon name="x" size={26} />
    </button>
  </div>

  <nav aria-label="Hauptnavigation">
    <ul class="drawer__list">
      {
        eintraege.map((item, i) => (
          <li style={`--i:${i}`}>
            <a
              href={url(item.pfad)}
              class:list={['drawer__link', { 'is-active': istAktiv(item.pfad), 'is-highlight': item.hervorgehoben }]}
              aria-current={istAktiv(item.pfad) ? 'page' : undefined}
            >
              {item.hervorgehoben && <Icon name="lifebuoy" size={20} />}
              <span>{item.titel}</span>
            </a>

            {/* Unterpunkte für Mitmachen (z. B. Matrix/Element Space) */}
            {item.unterpunkte && item.unterpunkte.length > 0 && (
              <ul class="drawer__sub">
                {item.unterpunkte.map((sub) => (
                  <li>
                    <a
                      href={url(sub.pfad)}
                      class="drawer__sublink drawer__sublink--accent"
                    >
                      <Icon name="message" size={16} />
                      <span>{sub.titel}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}

            {/* Unterpunkte für Organisation */}
            {item.pfad === '/organisation/' && orgSeiten.length > 0 && (
              <ul class="drawer__sub">
                {orgSeiten.map((s) => (
                  <li>
                    <a
                      href={url(`/organisation/${s.id}/`)}
                      class:list={['drawer__sublink', { 'is-active': istAktiv(`/organisation/${s.id}/`) }]}
                      aria-current={istAktiv(`/organisation/${s.id}/`) ? 'page' : undefined}
                    >
                      {s.data.titel}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="drawer__foot">
    <a class="btn btn--primary drawer__cta" href={kontaktMailto()}>
      <Icon name="mail" size={20} />
      Kontakt aufnehmen
    </a>
    <p class="drawer__meta">
      <a href={url('/impressum/')}>Impressum</a>
      <span aria-hidden="true">·</span>
      <a href={url('/datenschutz/')}>Datenschutz</a>
    </p>
    <img class="drawer__logo" src={url('/icon-192.png')} alt="" width="72" height="72" loading="lazy" />
    <span class="visually-hidden">{organisation.name}</span>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('hauptmenue') as HTMLDialogElement | null;
  const opener = document.getElementById('menu-oeffnen');

  if (dialog && opener) {
    const schliessen = () => {
      if (!dialog.open || dialog.classList.contains('is-closing')) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) {
        dialog.close();
        return;
      }
      dialog.classList.add('is-closing');
      dialog.addEventListener(
        'animationend',
        () => {
          dialog.classList.remove('is-closing');
          dialog.close();
        },
        { once: true },
      );
    };

    opener.addEventListener('click', () => {
      dialog.showModal();
      opener.setAttribute('aria-expanded', 'true');
      document.documentElement.classList.add('menu-open');
    });

    dialog.addEventListener('close', () => {
      opener.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('menu-open');
      opener.focus();
    });

    // ESC: eigene Animation statt sofortigem Schließen
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      schliessen();
    });

    dialog.querySelectorAll('[data-menu-close]').forEach((b) => b.addEventListener('click', schliessen));

    // Klick auf den abgedunkelten Hintergrund schließt das Menü
    dialog.addEventListener('click', (e) => {
      const r = dialog.getBoundingClientRect();
      const { clientX: x, clientY: y } = e as MouseEvent;
      if (x < r.left || x > r.right || y < r.top || y > r.bottom) schliessen();
    });

    // Links mit Anker schließen das Menü
    dialog.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => dialog.close()));
  }
</script>

<style>
  .drawer {
    position: fixed;
    inset: 0 auto 0 0;
    margin: 0;
    width: min(400px, 88vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0;
    border: 0;
    border-right: 1px solid var(--linie-rose);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background: var(--flaeche);
    color: var(--text);
    box-shadow: var(--schatten);
    overflow-y: auto;
    overscroll-behavior: contain;
    display: none;
    flex-direction: column;
  }
  .drawer[open] {
    display: flex;
    animation: drawer-in var(--dur) var(--ease) both;
  }
  .drawer.is-closing {
    animation: drawer-out 260ms ease-in both;
  }
  .drawer::backdrop {
    background: var(--waldgruen-tief);
    opacity: 0.8;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    animation: fade-in var(--dur) var(--ease) both;
  }
  .drawer.is-closing::backdrop {
    animation: fade-out 260ms ease-in both;
  }

  @keyframes drawer-in {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(0);
    }
  }
  @keyframes drawer-out {
    to {
      transform: translateX(-100%);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }
  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateX(-12px);
    }
  }

  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem 0.5rem 1.75rem;
    min-height: var(--header-h);
  }
  .drawer__title {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-leise);
  }
  .drawer__close {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--linie-rose);
    background: transparent;
    color: var(--akzent);
    cursor: pointer;
    transition:
      transform 300ms var(--ease),
      background-color 250ms var(--ease);
  }
  .drawer__close:hover {
    transform: rotate(90deg);
    background: var(--flaeche-erhoeht);
  }

  .drawer__list,
  .drawer__sub {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .drawer__list {
    padding: 0.5rem 1rem;
  }
  .drawer__list > li {
    animation: item-in 500ms var(--ease) both;
    animation-delay: calc(80ms + var(--i) * 35ms);
  }
  .drawer__link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 500;
    transition:
      background-color 200ms var(--ease),
      color 200ms var(--ease),
      padding-left 300ms var(--ease);
  }
  .drawer__link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 4px;
    height: 0;
    border-radius: 4px;
    background: var(--akzent);
    transform: translateY(-50%);
    transition: height 300ms var(--ease);
  }
  .drawer__link:hover {
    background: var(--flaeche-erhoeht);
    padding-left: 1.1rem;
    color: var(--text);
  }
  .drawer__link:hover::before,
  .drawer__link.is-active::before {
    height: 60%;
  }
  .drawer__link.is-active {
    color: var(--akzent);
    padding-left: 1.1rem;
  }
  .drawer__link.is-highlight {
    margin-top: 0.75rem;
    border-top: 1px solid var(--linie);
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    padding-top: 1.1rem;
    font-size: 1.1rem;
    color: var(--akzent);
  }

  .drawer__sub {
    margin: -0.2rem 0 0.6rem 1.6rem;
    border-left: 1.5px solid var(--linie-rose);
    padding-left: 0.4rem;
  }
  .drawer__sublink {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.6rem;
    color: var(--text-leise);
    text-decoration: none;
    font-size: 0.95rem;
    border-radius: 6px;
    transition: color 200ms var(--ease), background 200ms var(--ease);
  }
  .drawer__sublink:hover,
  .drawer__sublink.is-active {
    color: var(--akzent);
    background: var(--flaeche-erhoeht);
  }
  .drawer__sublink--accent {
    color: var(--akzent);
    font-weight: 500;
  }

  .drawer__foot {
    margin-top: auto;
    padding: 1.5rem 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .drawer__cta {
    width: 100%;
    justify-content: center;
  }
  .drawer__meta {
    margin: 0;
    display: flex;
    gap: 0.6rem;
    font-size: var(--fs-small);
    color: var(--text-leise);
  }
  .drawer__meta a {
    color: var(--text-leise);
  }
  .drawer__logo {
    width: 56px;
    height: 56px;
    opacity: 0.9;
  }
</style>

<style is:global>
  html.menu-open {
    overflow: hidden;
  }
</style>
