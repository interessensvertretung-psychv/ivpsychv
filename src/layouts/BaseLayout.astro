---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MenuDrawer from '../components/MenuDrawer.astro';
import MatrixFloatingButton from '../components/MatrixFloatingButton.astro';
import { organisation } from '../config/organisation';
import { url } from '../lib/utils';

interface Props {
  titel?: string;
  beschreibung?: string;
  /** Startseite: Header/Footer kompakter, damit das Karussell den Bildschirm füllt */
  startseite?: boolean;
  noindex?: boolean;
}

const { titel, beschreibung = organisation.beschreibung, startseite = false, noindex = false } = Astro.props;
const seitenTitel = titel ? `${titel} – ${organisation.name}` : organisation.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('/og-image.png'), Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{seitenTitel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#fbf4f3" />
    <meta name="color-scheme" content="light" />

    <!-- ?v= erhöhen, wenn sich das Logo ändert – sonst zeigen Browser das alte Icon aus dem Cache -->
    <link rel="icon" href={url('/favicon.ico') + '?v=4'} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png') + '?v=4'} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png') + '?v=4'} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={organisation.name} />
    <meta property="og:title" content={seitenTitel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class:list={{ 'is-home': startseite }}>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <MenuDrawer />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <MatrixFloatingButton />
    <Footer kompakt={startseite} />
  </body>
</html>
